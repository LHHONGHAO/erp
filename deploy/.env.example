# Copy to .env on the server and generate unique passwords before starting Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
APP_DB_PASSWORD=replace-with-a-different-long-random-password

# Persistent directories must stay outside the application release directory.
JSHERP_DATA_ROOT=/srv/jsherp-data
JSHERP_BACKUP_ROOT=/srv/jsherp-backup
