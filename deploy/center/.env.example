# 复制为 center/.env，并生成独立强密码后再 docker compose up -d
MYSQL_ROOT_PASSWORD=replace-with-long-random-root-password

# 客户端连接数据库用的业务账号密码（对应 MYSQL_USER=jsherp）
APP_DB_PASSWORD=replace-with-a-different-long-random-password

# Redis 访问密码（客户端 SPRING_REDIS_PASSWORD 需要一致）
REDIS_PASSWORD=replace-with-long-random-redis-password

# SMB 共享访问密码（客户端挂载 config 目录用，用户名为 jsherp）
SAMBA_PASSWORD=replace-with-long-random-samba-password

# 持久化目录（必须位于程序发布目录之外）
JSHERP_DATA_ROOT=/srv/jsherp-data
JSHERP_BACKUP_ROOT=/srv/jsherp-backup
