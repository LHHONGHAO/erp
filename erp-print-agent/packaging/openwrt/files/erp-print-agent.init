#!/bin/sh /etc/rc.common

# erp-print-agent: OpenWrt 远程打印代理
# 由 procd 管理，实现开机自启与异常自动重启。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/erp-print-agent
CONFIG=/etc/erp-print-agent/config.json

start_service() {
	if [ ! -f "$CONFIG" ]; then
		logger -t erp-print-agent "缺少配置文件 $CONFIG，服务未启动"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" -config "$CONFIG" serve
	# 异常退出后自动重启：3600 秒内最多 5 次，间隔 5 秒
	procd_set_param respawn 3600 5 5
	# 配置文件变化时触发 reload_service
	procd_set_param file "$CONFIG"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

reload_service() {
	stop
	start
}
